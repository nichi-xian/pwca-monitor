# For local Telegram tests only. Copy to .env and fill in (.env is excluded by .gitignore).
# Use: set -a; source .env; set +a
# In GitHub Actions, use GitHub Secrets instead of this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override the site URL/directory in config/targets.yaml
# PWCA_BASE_URL=https://pwca.org
# PWCA_EVENTS_PATH=/events/
